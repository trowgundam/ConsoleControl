<Window
    x:Class="ConsoleControl.Gui.MappingWindow"
    x:DataType="local:MappingWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ConsoleControl.Gui"
    xmlns:core="using:ConsoleControl.Core"
    Title="Configure input mapping"
    Width="820"
    Height="680"
    MinWidth="780"
    MinHeight="630"
    WindowStartupLocation="CenterOwner"
    CanResize="True">
  <Window.Styles>
    <Style Selector="Button.map">
      <Setter Property="Width" Value="72" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.map.dpad">
      <Setter Property="Width" Value="64" />
      <Setter Property="Height" Value="64" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.face">
      <Setter Property="Width" Value="68" />
      <Setter Property="Height" Value="68" />
      <Setter Property="CornerRadius" Value="34" />
      <Setter Property="FontSize" Value="22" />
    </Style>
    <Style Selector="Button.stick">
      <Setter Property="Width" Value="82" />
      <Setter Property="FontSize" Value="15" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="22" RowSpacing="10">
    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock Text="Map host controls" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="{Binding ProfileName}" FontSize="15" />
      <TextBlock Text="Choose a console control, then press the host input you want to bind. Mappings are local and do not require control of the console." TextWrapping="Wrap" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,*,80,80,*,*" ColumnSpacing="8"
          IsEnabled="{Binding CanStartCapture}">
      <Button Grid.Column="0" Classes="map" Content="ZL" Command="{Binding CaptureCommand}"
              CommandParameter="{x:Static core:CanonicalDigitalControl.LeftTrigger}" />
      <Button Grid.Column="1" Classes="map" Content="L" Command="{Binding CaptureCommand}"
              CommandParameter="{x:Static core:CanonicalDigitalControl.LeftShoulder}" />
      <Button Grid.Column="2" Classes="map" Content="−" Command="{Binding CaptureCommand}"
              CommandParameter="{x:Static core:CanonicalDigitalControl.Minus}" />
      <Button Grid.Column="3" Classes="map" Content="+" Command="{Binding CaptureCommand}"
              CommandParameter="{x:Static core:CanonicalDigitalControl.Plus}" />
      <Button Grid.Column="4" Classes="map" Content="R" HorizontalAlignment="Right" Command="{Binding CaptureCommand}"
              CommandParameter="{x:Static core:CanonicalDigitalControl.RightShoulder}" />
      <Button Grid.Column="5" Classes="map" Content="ZR" HorizontalAlignment="Right" Command="{Binding CaptureCommand}"
              CommandParameter="{x:Static core:CanonicalDigitalControl.RightTrigger}" />
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="1*,1.2*,1*" VerticalAlignment="Center">
      <Grid Grid.Column="0" Width="192" Height="192" RowDefinitions="64,64,64" ColumnDefinitions="64,64,64"
            IsEnabled="{Binding CanStartCapture}">
        <Button Grid.Row="0" Grid.Column="1" Classes="map dpad" Content="▲" Command="{Binding CaptureCommand}"
                CommandParameter="{x:Static core:CanonicalDigitalControl.DPadUp}" />
        <Button Grid.Row="1" Grid.Column="0" Classes="map dpad" Content="◀" Command="{Binding CaptureCommand}"
                CommandParameter="{x:Static core:CanonicalDigitalControl.DPadLeft}" />
        <Border Grid.Row="1" Grid.Column="1" Width="58" Height="50"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
        <Button Grid.Row="1" Grid.Column="2" Classes="map dpad" Content="▶" Command="{Binding CaptureCommand}"
                CommandParameter="{x:Static core:CanonicalDigitalControl.DPadRight}" />
        <Button Grid.Row="2" Grid.Column="1" Classes="map dpad" Content="▼" Command="{Binding CaptureCommand}"
                CommandParameter="{x:Static core:CanonicalDigitalControl.DPadDown}" />
      </Grid>

      <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Stretch">
        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"
                    IsEnabled="{Binding CanStartCapture}">
          <Button Classes="map stick" Content="L STICK" Command="{Binding CaptureStickCommand}"
                  CommandParameter="{x:Static core:CanonicalStick.Left}" />
          <Button Classes="map stick" Content="R STICK" Command="{Binding CaptureStickCommand}"
                  CommandParameter="{x:Static core:CanonicalStick.Right}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"
                    IsEnabled="{Binding CanStartCapture}">
          <Button Classes="map" Content="L3" Command="{Binding CaptureCommand}"
                  CommandParameter="{x:Static core:CanonicalDigitalControl.LeftStickClick}" />
          <Button Classes="map" Content="R3" Command="{Binding CaptureCommand}"
                  CommandParameter="{x:Static core:CanonicalDigitalControl.RightStickClick}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"
                    IsEnabled="{Binding CanStartCapture}">
          <Button Classes="map" Content="CAP" Command="{Binding CaptureCommand}"
                  CommandParameter="{x:Static core:CanonicalDigitalControl.Capture}" />
          <Button Classes="map" Content="HOME" Command="{Binding CaptureCommand}"
                  CommandParameter="{x:Static core:CanonicalDigitalControl.Home}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="Bindings for" FontWeight="SemiBold" />
          <TextBlock Text="{Binding SelectedTargetLabel}" FontWeight="SemiBold" />
        </StackPanel>
        <ListBox Height="72" ItemsSource="{Binding CurrentBindings}"
                 SelectedItem="{Binding SelectedBinding, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="local:MappingBindingRow">
              <TextBlock Text="{Binding DisplayName}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button Content="Remove Selected Binding" Command="{Binding RemoveBindingCommand}" />
      </StackPanel>

      <Grid Grid.Column="2" Width="204" Height="204" RowDefinitions="68,68,68" ColumnDefinitions="68,68,68"
            IsEnabled="{Binding CanStartCapture}">
        <Button Grid.Row="0" Grid.Column="1" Classes="map face" Content="X" Command="{Binding CaptureCommand}"
                CommandParameter="{x:Static core:CanonicalDigitalControl.X}" />
        <Button Grid.Row="1" Grid.Column="0" Classes="map face" Content="Y" Command="{Binding CaptureCommand}"
                CommandParameter="{x:Static core:CanonicalDigitalControl.Y}" />
        <Button Grid.Row="1" Grid.Column="2" Classes="map face" Content="A" Command="{Binding CaptureCommand}"
                CommandParameter="{x:Static core:CanonicalDigitalControl.A}" />
        <Button Grid.Row="2" Grid.Column="1" Classes="map face" Content="B" Command="{Binding CaptureCommand}"
                CommandParameter="{x:Static core:CanonicalDigitalControl.B}" />
      </Grid>
    </Grid>

    <Border Grid.Row="3" Classes="card" Padding="12,8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="Cancel Capture" Command="{Binding CancelCaptureCommand}"
                IsVisible="{Binding IsCapturing}" />
      </Grid>
    </Border>

    <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
      <Button Grid.Column="0" Content="Reset to Defaults" Command="{Binding ResetCommand}"
              IsEnabled="{Binding CanStartCapture}" />
      <Button Grid.Column="2" Content="Cancel" Click="Cancel_Click" />
      <Button Grid.Column="3" Classes="primary" Content="Save" Click="Save_Click"
              IsEnabled="{Binding CanStartCapture}" />
    </Grid>
  </Grid>
</Window>
